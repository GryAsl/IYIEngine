# One line ending in every working copy (scripted edits break on mixed files): LF, except batch
# files, which cmd needs in CRLF. The repository itself already stores LF.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh text eol=lf

# Media goes through Git LFS (from 2026-11-11; earlier history keeps the old blobs).
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mpg filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
