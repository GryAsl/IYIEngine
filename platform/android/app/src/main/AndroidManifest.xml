<?xml version="1.0" encoding="utf-8"?>
<!-- Offline-first: no permissions. Saves live in internal storage (filesDir) and join Android
     Auto Backup (Gry's decision 2026-11-15); the re-extractable Python stdlib is excluded. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- LVL client-side licence check (License.java); inert unless release.json has the key. -->
    <uses-permission android:name="com.android.vending.CHECK_LICENSE" />

    <application
        android:label="@string/app_name"
        android:icon="${iyiIcon}"
        android:roundIcon="${iyiIcon}"
        android:hasCode="true"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:theme="@style/IYITheme">
        <activity
            android:name="com.iyi.engine.IYIActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density|fontScale|fontWeightAdjustment|colorMode|grammaticalGender|layoutDirection|locale|mcc|mnc|touchscreen"
            android:launchMode="singleTask"
            android:resizeableActivity="false">
            <meta-data android:name="android.app.lib_name" android:value="iyigame" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
