"""engine.net: multiplayer (SPEC §25). Present only when the project lists libraries/net."""

from typing import Any

class FieldType: ...

HOST: int
ALL: int
OTHERS: int

bool: FieldType
u8: FieldType
u16: FieldType
u32: FieldType
i8: FieldType
i16: FieldType
i32: FieldType
f32: FieldType
player: FieldType
ref: FieldType

def fixed(min: float, max: float, step: float) -> FieldType: ...
def angle(bits: int = 12) -> FieldType: ...
def vec2(min: float, max: float, step: float) -> FieldType: ...
def vec3(min: float, max: float, step: float) -> FieldType: ...
def text(max_bytes: int) -> FieldType: ...
def bytes(max_bytes: int) -> FieldType: ...

# --- session ---
def host(transport: str = "enet", port: int = 7777, max_players: int = 8, tick_rate: int = 30, name: str = "",
         public: bool = True, data: dict[str, str] = ..., player_name: str = "", timeout: float = 10.0,
         migration_timeout: float = 3.0) -> bool: ...
def join(target: str | dict[str, Any], player_name: str = "") -> bool: ...
def find(transport: str = "enet") -> None: ...
def leave() -> None: ...
def simulate(latency_ms: float = 0.0, jitter_ms: float = 0.0, loss: float = 0.0) -> None: ...
def state() -> str: ...
def is_host() -> bool: ...
def local_player() -> int: ...
def tick() -> int: ...
def set_lobby_data(key: str, value: str) -> None: ...
def players() -> list[dict[str, Any]]: ...
def stats() -> dict[str, Any]: ...
def events() -> list[dict[str, Any]]: ...

# --- replicated objects ---
def define(kind: str, **fields: FieldType) -> None: ...

class Object:
    @property
    def id(self) -> int: ...
    @property
    def kind(self) -> str: ...
    @property
    def owner(self) -> int: ...
    @property
    def authority(self) -> str: ...
    @property
    def exists(self) -> bool: ...
    priority: float
    def __getattr__(self, name: str) -> Any: ...
    def __setattr__(self, name: str, value: Any) -> None: ...
    def sample(self, field: str) -> Any: ...
    def hide_from(self, player: int) -> None: ...
    def show_to(self, player: int) -> None: ...
    def despawn(self) -> bool: ...

def spawn(kind: str, owner: int = 0, authority: str = "host", priority: float = 1.0, **values: Any) -> Object | None: ...
def objects(kind: str | None = None) -> list[Object]: ...
def get(object_id: int) -> Object | None: ...

# --- messages ---
def message(name: str, **fields: FieldType) -> None: ...
def send(name: str, to: int = ..., reliable: bool = True, **values: Any) -> bool: ...
def receive() -> list[dict[str, Any]]: ...

# --- inputs and lag compensation ---
def define_input(**fields: FieldType) -> None: ...
def send_input(**values: Any) -> int: ...
def inputs(player: int) -> list[dict[str, Any]]: ...
def input_ack() -> int: ...
def rewind(tick: int) -> dict[int, dict[str, Any]]: ...
