# Video playback (engine docs/SPEC.md §23): MPEG-1 video with optional MP2 audio in a .mpg file.

class Video:
    state: str          # "ready" | "playing" | "paused" | "ended" | "error" | "closed"
    duration: float
    position: float
    width: int
    height: int
    has_audio: bool
    error: str
    def play(self) -> None: ...
    def pause(self) -> None: ...
    def resume(self) -> None: ...
    def stop(self) -> None: ...
    def close(self) -> None: ...
    def set_volume(self, volume: float) -> None: ...
    def draw_fit(self, x: float, y: float, width: float, height: float) -> None: ...

def open(path: str) -> Video: ...
